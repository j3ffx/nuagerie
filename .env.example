# Copy this file to .env and fill in the values (see docs/SETUP.md).
# .env is ignored by git. A SPA needs no secret: never put one here.

# Application (client) ID of the Microsoft Entra app registration.
# Not a secret, but kept out of the repository anyway.
VITE_MSAL_CLIENT_ID=

# Optional: set to 1 to always start in demo mode (synthetic data, no account).
# `npm run dev:demo` sets it for you.
VITE_DEMO=
