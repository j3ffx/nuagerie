{
  "name": "nuagerie",
  "private": true,
  "version": "0.2.0",
  "description": "Galerie photo personnelle en lecture seule pour OneDrive (PWA).",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:lan": "vite --mode lan",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:private": "node scripts/check-tracked.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "fix:dates": "node scripts/commit-date.mjs --fix",
    "check:dist": "node scripts/check-dist.mjs",
    "deploy": "npm run build && npm run check:dist && wrangler pages deploy dist --project-name nuagerie"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.24.0",
    "@azure/msal-react": "^5.7.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supercluster": "^9.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
